{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/users/(.*)", "destination": "/api/users" },
    { "source": "/api/expenses/(.*)", "destination": "/api/expenses" },
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ]
}
